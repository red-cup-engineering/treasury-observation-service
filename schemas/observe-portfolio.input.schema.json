{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "treasury-observation-service/observe-portfolio-input",
  "title": "Observe a wallet portfolio",
  "description": "Observe public wallet balances, rewards, supplied assets, borrow balances, and ERC-4626 vault assets at one selected block per chain.",
  "type": "object",
  "required": [
    "roster"
  ],
  "additionalProperties": false,
  "properties": {
    "roster": {
      "title": "Wallets",
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "subject",
          "address"
        ],
        "additionalProperties": false,
        "properties": {
          "subject": {
            "title": "Wallet label",
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "address": {
            "$ref": "#/$defs/address"
          }
        }
      }
    },
    "chains": {
      "title": "Chains",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ethereum",
          "base",
          "arbitrum",
          "optimism",
          "polygon",
          "bsc",
          "avalanche",
          "ronin"
        ]
      },
      "description": "Omit to observe all registered chains."
    },
    "positions": {
      "title": "Tracked investment positions",
      "type": "object",
      "propertyNames": {
        "enum": [
          "ethereum",
          "base",
          "arbitrum",
          "optimism",
          "polygon",
          "bsc",
          "avalanche",
          "ronin"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "$ref": "#/$defs/position"
        }
      },
      "description": "Each selected market or vault is observed for every wallet on its chain, independently of token discovery."
    },
    "moonwell": {
      "title": "Moonwell rewards",
      "type": "object",
      "propertyNames": {
        "enum": [
          "ethereum",
          "base",
          "arbitrum",
          "optimism",
          "polygon",
          "bsc",
          "avalanche",
          "ronin"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "rewardDistributor"
        ],
        "additionalProperties": false,
        "properties": {
          "rewardDistributor": {
            "$ref": "#/$defs/address"
          }
        }
      }
    },
    "finality": {
      "title": "Block selection",
      "type": "string",
      "enum": [
        "latest",
        "safe",
        "finalized"
      ],
      "default": "finalized"
    },
    "concurrency": {
      "title": "Concurrent wallets",
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "default": 4
    },
    "timeoutMs": {
      "title": "Provider request timeout (milliseconds)",
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 15000
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "position": {
      "type": "object",
      "required": [
        "kind",
        "address"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Position type",
          "type": "string",
          "enum": [
            "compound-fork",
            "erc4626"
          ],
          "description": "Compound-fork markets return supplied and borrowed assets with current rates; ERC-4626 vaults return shares and underlying asset amounts."
        },
        "address": {
          "$ref": "#/$defs/address"
        }
      }
    }
  }
}

