{
  "name": "@red-cup-engineering/treasury-observation-service",
  "version": "0.5.3",
  "type": "module",
  "description": "Read-only observation of the Group's on-chain treasury: EVM balances and positions plus normalized, provenance-bearing cross-chain earning opportunities. Distinguishes a checked zero from an unchecked chain and unavailable APY from zero yield, always.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/treasury-observation-service.git"
  },
  "keywords": [
    "561-group",
    "treasury",
    "cross-chain",
    "evm",
    "hive",
    "balance",
    "opportunity",
    "observation",
    "read-only",
    "defi"
  ],
  "scripts": {
    "check": "for f in src/*.mjs; do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": {
      "default": "./src/index.mjs"
    },
    "./chains": {
      "default": "./src/chains.mjs"
    },
    "./native": {
      "default": "./src/native.mjs"
    },
    "./tokens": {
      "default": "./src/tokens.mjs"
    },
    "./positions": {
      "default": "./src/positions.mjs"
    },
    "./rewards": {
      "default": "./src/rewards.mjs"
    },
    "./portfolio": {
      "default": "./src/portfolio.mjs"
    },
    "./opportunities": {
      "default": "./src/opportunities.mjs"
    },
    "./hive-engine-opportunities": {
      "default": "./src/hive-engine-opportunities.mjs"
    },
    "./morpho": {
      "default": "./src/morpho.mjs"
    },
    "./observe-morpho-vault-position": "./scripts/observe-morpho-vault-position.mjs",
    "./observe-moonwell-claimable-rewards": "./scripts/observe-moonwell-claimable-rewards.mjs",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "@red-cup-engineering/json-schema-services-section": "0.5.0",
    "@red-cup-engineering/ethereum-engineering-services-section": "0.15.2",
    "@red-cup-engineering/normalize-earning-opportunity-service": "0.1.1",
    "@red-cup-engineering/observe-hive-engine-liquidity-opportunity-service": "0.1.2"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "src",
    "scripts",
    "schemas",
    "README.md"
  ],
  "private": false
}
